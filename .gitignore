# Internal engineering notes — the architecture map and the sizing tables
# are for the people working on the code, not for the users downloading a
# release. Kept in the working tree, deliberately not published:
docs/ARCHITECTURE.md
docs/SIZING.md

# Release artifacts — produced by packaging/build-release.sh and uploaded to
# GitHub Releases, never committed back into the repo:
release-*/
*.tar.gz

# ctest droppings when run from the repo root
Testing/

# patch-tool leftovers
*.orig

# python bytecode from the generation/audit scripts
__pycache__/
*.pyc
probes/
