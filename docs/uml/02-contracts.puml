@startuml 02-contracts
!theme plain
title 2. 核心契约类 — final / override / 纯虚 measured in the headers

interface "IGameReader" as IGameReader {
  +~IGameReader() = default
  +poll() : GameSnapshot  {pure}
  +mapPath() : const QString&  {pure}
  --
  typedef GameReaderPtr = unique_ptr<IGameReader>
}
note right of IGameReader
  <<abstract>>
  core/game_reader.h:39
  两个纯虚函数，接口全部面只有这两个
end note

class "GameSnapshot" as GameSnapshot {
  +game : GameId
  +attached : bool
  +pid : qint64
  +imageBase : uintptr_t
  +status : QString
  +zone : ZoneRef
  +monsters : QVector<MonsterSnapshot>
  +player : PlayerSnapshot
  +party : QVector<PartyMemberSnapshot>
  +quest : QuestSnapshot
  +playerCount : int
  +isMultiplayer : bool
}
note bottom of GameSnapshot
  <<struct>>
  core/game_snapshot.h:14
  UI 与 reader 之间唯一的来回类型
end note

class "ZoneRef" as ZoneRef {
  +game : GameId {World}
  +id : int {kZoneUnknownId = -1}
  --
  +operator== / !=  (constexpr)
  isUnknownZone(z)  (constexpr)
}
note right of ZoneRef
  <<struct>> core/zone_id.h:54
  isUnknownZone ≠ hasZoneName；
  hasZoneName 住在游戏侧
end note

enum "GameId" as GameId {
  World
  Rise
}
note right of GameId
  <<enum>> monster/monster_types.h:18
end note

class "MonsterSnapshot" as MonsterSnapshot {
  +address : uintptr_t
  +id : int
  +game : GameId
  +health / maxHealth : float
  +stamina / size / enrage* : float
  +parts : QVector<PartSnapshot>
  +ailments : QVector<…>
  +qurio* (Rise only)
}

class "PartSnapshot" as PartSnapshot {
  +partType : PartType {Flinch, Severable, Breakable}
  +health / maxHealth  (sever layer)
  +breakHealth / breakMaxHealth
  +flinch / maxFlinch
  +isSeverable / isBreakable
  +isBroken / isPartSevered
  +tenderize{Duration,MaxDuration}
}

class "PlayerSnapshot / QuestSnapshot" as Shared {
  player_types.h · quest_types.h
  header-only：no .cpp, not in
  any add_library — contract paper
}

class "MhwReader" as MhwReader {
  +selectLoadableMap(QStringList) : QString  {static}
  +poll() : GameSnapshot  override
  +mapPath() : const QString&  override
  --
  findGamePid / selectLoadableMap
  stay World-side
}
note right of MhwReader
  <<class final : IGameReader>>
  world/world_reader.h:17
end note

class "MhrReader" as MhrReader {
  +findBestMap(QStringList) : QString  {static}
  +poll() : GameSnapshot  override
  +mapPath() : const QString&  override
  --
  findRisePid / readZone
  stay Rise-side
}
note right of MhrReader
  <<class final : IGameReader>>
  rise/mhr_reader.h:546
end note

abstract class "Panel : QMainWindow" as Panel {
  +update(const GameSnapshot&)
  #paintPanel(QPainter&)  {pure}
  #onSnapshot(const GameSnapshot&)
  +retranslateUi()
}

MhwReader --|> IGameReader
MhrReader --|> IGameReader
GameSnapshot *-- ZoneRef : zone
GameSnapshot o-- MonsterSnapshot : monsters
GameSnapshot ..> Shared
GameSnapshot --> GameId : game
ZoneRef ..> GameId
MonsterSnapshot *-- PartSnapshot : parts
MonsterSnapshot --> GameId : game
Panel ..> GameSnapshot : update()

@enduml
