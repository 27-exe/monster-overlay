sequenceDiagram
  autonumber
  participant M as "main.cpp tick\n(isRise)"
  participant A as "slot A\nreframework/data/mhr_damage_a.json"
  participant B as "slot B\nreframework/data/mhr_damage_b.json"
  participant L as "slot L (legacy)\n/tmp/mhr_damage.json"
  participant P as "DamagePanel /\nPetDamagePanel"

  Note over M: main.cpp:534 — tick && isRise
  M->>M: skipUpdate(damagePanel) ||<br/>skipUpdate(petDamagePanel)? :537-539
  alt true
    M-->>P: no feed read this tick<br/>(panels keep demo state)
  else false
    M->>M: newestReader = nullptr<br/>diagnosticReader = riseDamageReaders.front().get()<br/>:553-554 — slot A starts as the diagnostic candidate
    loop each of 3 readers (main.cpp:404-417)
      A->>A: update()
      alt update() ok
        A->>M: sequence > current.seq<br/>|| (sequence == && timestampMs >)<br/>:558-564
        Note over M: yes → newestReader = &reader<br/>no → keep current
      else update() failed
        Note over A: missing / >1 MiB / symlink / unparsable /<br/>unsupported version / older than 5 s
        A->>M: peer holds a real error?<br/>:574-577 — replaces only when<br/>current candidate is Error::Missing
        Note over M: yes → diagnosticReader = &reader<br/>first real error sticks; slot A wins ties
      end
    end
    Note over M,B,L: update() 失败也照样推进循环，不会提前退出
    alt newestReader != nullptr :582
      M->>M: lastRiseDamageFeedError = None<br/>damageSnapshot = newestReader->snapshot()
      M->>M: enrichRiseDamageSnapshot(dmg, snap)<br/>rise_damage_roster.cpp:84 — merges the<br/>GameSnapshot into the damage roster
      M->>P: damagePanel.updateRiseDamage(dmg) :593<br/>petDamagePanel.updateRiseDamage(dmg) :595
      Note over P: lastRiseDamageFeedError available
    else feed lost
      M->>M: diagnosticReader->lastError() /<br/>lastErrorText() → qInfo / qWarning<br/>:597-611 — severity depends on the<br/>error kind, Missing logs as info
      M->>P: deliver invalid RiseDamageSnapshot :615<br/>(panels clear old quest data<br/>instead of freezing the last chart)
    end
    M->>P: damagePanel.setVisible(<br/>panelEnabled() && hasVisibleContent())<br/>petDamagePanel likewise :627-641<br/>triggerUpdate() → paintPanel()
  end
