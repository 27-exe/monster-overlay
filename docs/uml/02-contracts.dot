digraph g02_contracts {
graph [bgcolor="white", pad="0.35", splines=polyline, nodesep="0.4", ranksep="0.55", fontname="Helvetica", fontsize=13];
node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", color="#9CA3AF", fontcolor="#111827", margin="0.14,0.09"];
edge [fontname="Helvetica", fontsize=10, color="#374151", fontcolor="#374151"];


  labelloc="t";
  label=<<B>2. 核心契约类</B><BR/><FONT POINT-SIZE="10">final / override / pure-virtual measured in the headers; field list is the contract surface, not every field</FONT>>;

  igame [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DBEAFE" COLSPAN="1"><B>IGameReader</B></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="9" COLOR="#4B5563"><I>&lt;&lt;abstract · core/game_reader.h:39&gt;&gt;</I></FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+~IGameReader() = default</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+poll() : GameSnapshot  {pure}</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+mapPath() : const QString&amp;  {pure}</FONT></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="4">&#160;</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">typedef GameReaderPtr =</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">  unique_ptr&lt;IGameReader&gt;</FONT></TD></TR></TABLE>>];
  mhw  [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCFCE7" COLSPAN="1"><B>MhwReader</B></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="9" COLOR="#4B5563"><I>&lt;&lt;class final : IGameReader · world/world_reader.h:17&gt;&gt;</I></FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+selectLoadableMap(QStringList) : QString  {static}</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+poll() : GameSnapshot  override</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+mapPath() : const QString&amp;  override</FONT></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="4">&#160;</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">findGamePid / selectLoadableMap</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">stay World-side</FONT></TD></TR></TABLE>>];
  mhr  [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#DCFCE7" COLSPAN="1"><B>MhrReader</B></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="9" COLOR="#4B5563"><I>&lt;&lt;class final : IGameReader · rise/mhr_reader.h:546&gt;&gt;</I></FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+findBestMap(QStringList) : QString  {static}</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+poll() : GameSnapshot  override</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+mapPath() : const QString&amp;  override</FONT></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="4">&#160;</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">findRisePid / readZone</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">stay Rise-side</FONT></TD></TR></TABLE>>];
  snap [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3F4F6" COLSPAN="1"><B>GameSnapshot</B></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="9" COLOR="#4B5563"><I>&lt;&lt;struct · core/game_snapshot.h:14 · 14 fields&gt;&gt;</I></FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+game : GameId</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+attached : bool</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+pid : qint64</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+imageBase : uintptr_t</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+status : QString</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+zone : ZoneRef</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+monsters : QVector&lt;MonsterSnapshot&gt;</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+player : PlayerSnapshot</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+party : QVector&lt;PartyMemberSnapshot&gt;</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+quest : QuestSnapshot</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+playerCount : int</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+isMultiplayer : bool</FONT></TD></TR></TABLE>>];
  zone [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FEF3C7" COLSPAN="1"><B>ZoneRef</B></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="9" COLOR="#4B5563"><I>&lt;&lt;struct · core/zone_id.h:54&gt;&gt;</I></FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+game : GameId {World}</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+id : int {kZoneUnknownId = -1}</FONT></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="4">&#160;</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+operator== / !=  (constexpr)</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">isUnknownZone(z)  (constexpr)</FONT></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="4">&#160;</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">NOT the same question as</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">hasZoneName() — that lives</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">on the game side</FONT></TD></TR></TABLE>>];
  gameid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FECACA" COLSPAN="1"><B>GameId</B></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="9" COLOR="#4B5563"><I>&lt;&lt;enum · monster/monster_types.h:18&gt;&gt;</I></FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">enum class {</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">    World,</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">    Rise</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">}</FONT></TD></TR></TABLE>>];
  monster [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3F4F6" COLSPAN="1"><B>MonsterSnapshot</B></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="9" COLOR="#4B5563"><I>&lt;&lt;struct · monster_types.h:106&gt;&gt;</I></FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+address : uintptr_t</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+id : int</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+game : GameId</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+health / maxHealth : float</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+stamina / size / enrage* : float</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+parts : QVector&lt;PartSnapshot&gt;</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+ailments : QVector&lt;…&gt;</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+qurio* (Rise only)</FONT></TD></TR></TABLE>>];
  part [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3F4F6" COLSPAN="1"><B>PartSnapshot</B></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="9" COLOR="#4B5563"><I>&lt;&lt;struct · monster_types.h:35&gt;&gt;</I></FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+partType : PartType</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">    {Flinch, Severable, Breakable}</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+health / maxHealth  (sever layer)</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+breakHealth / breakMaxHealth</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+flinch / maxFlinch</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+isSeverable / isBreakable</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+isBroken / isPartSevered</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+tenderize{Duration,MaxDuration}</FONT></TD></TR></TABLE>>];
  external [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E5E7EB" COLSPAN="1"><B>PlayerSnapshot / QuestSnapshot</B></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="9" COLOR="#4B5563"><I>&lt;&lt;shared vocabulary&gt;&gt;</I></FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">player_types.h · quest_types.h</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">header-only: no .cpp, not in</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">any add_library — contract paper</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">shared by both games</FONT></TD></TR></TABLE>>];
  panel [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEDD5" COLSPAN="1"><B>Panel : QMainWindow</B></TD></TR><TR><TD COLSPAN="1"><FONT POINT-SIZE="9" COLOR="#4B5563"><I>&lt;&lt;abstract base · ui/panel.h:32&gt;&gt;</I></FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+update(const GameSnapshot&amp;)</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">#paintPanel(QPainter&amp;)  {pure}</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">#onSnapshot(const GameSnapshot&amp;)</FONT></TD></TR><TR><TD ALIGN="left" BALIGN="LEFT"><FONT POINT-SIZE="10">+retranslateUi()</FONT></TD></TR></TABLE>>];

  mhw -> igame [arrowhead=onormal, label="&lt;&lt;final&gt;&gt;"];
  mhr -> igame [arrowhead=onormal, label="&lt;&lt;final&gt;&gt;"];
  snap -> zone [arrowhead=vee, label="zone"];
  snap -> monster [arrowhead=vee, label="monsters"];
  snap -> external [arrowhead=vee, style=dashed];
  snap -> gameid [arrowhead=vee, label="game"];
  zone -> gameid [arrowhead=vee, style=dashed];
  monster -> part [arrowhead=vee, label="parts"];
  monster -> gameid [arrowhead=vee, style=dashed, label="game"];
  panel -> snap [arrowhead=vee, style=dashed, label="update()"];
  igame -> snap [arrowhead=vee, label="poll() returns"];
}
